# Sistem lama (CodeIgniter) - cuma dipakai sebagai ACUAN untuk membangun sistem baru,
# bukan bagian dari project ini, tidak perlu (dan tidak boleh) ikut di-push ke GitHub.
eproc/

# Dump database yang berisi data asli atau belum bisa dipastikan isinya - simpan lokal saja
*.dump
database/dump-eproc_migrasi-*.sql

# (Baris "PHP dependencies (aplikasi lama eproc): vendor/" yang dulu ada di sini dihapus -
# selain sudah redundan (eproc/ di atas sudah meng-ignore semuanya termasuk vendor/ di dalamnya),
# pola itu ternyata juga ikut mengenai folder BENAR src/components/vendor/ punya sistem baru
# ini sendiri, jadi folder itu diam-diam tidak pernah ter-track git. Ditemukan 2026-09-02 waktu
# menambahkan fitur Tindak Lanjut Verifikasi Vendor.)

# File yang diunggah pengguna lewat aplikasi baru (dokumen vendor, dst) - bukan source code
# (folder ini otomatis dibuat lagi oleh server/index.js kalau belum ada)
server/uploads/

# Backup database (berisi data asli) - dibuat lewat node server/backup_database.js, simpan lokal saja
backups/

# Hasil testing otomatis (Playwright) - dibuat ulang tiap kali test dijalankan
test-results/
tests/e2e/report/
playwright-report/
blob-report/
playwright/.cache/
