{
  "name": "eproc/codeigniter-4-react",
  "description": "eProcurement System with CodeIgniter 4 and React",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "codeigniter4/framework": "^4.4",
    "phpmailer/phpmailer": "^6.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    }
  },
  "scripts": {
    "serve": "php spark serve",
    "migrate": "php spark migrate",
    "test": "phpunit"
  }
}
