# Server Environment Configuration
# Copy file ini, rename menjadi .env, lalu sesuaikan nilainya

# ── Database MySQL (Laragon) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dpbj_ui
DB_USER=root
DB_PASS=

# ── Server ──
PORT=3001
NODE_ENV=development

# ── CORS: URL frontend React ──
FRONTEND_URL=http://localhost:5174

# ── JWT Secret (untuk auth nanti) ──
JWT_SECRET=dpbj_ui_super_secret_2025_change_in_production
JWT_EXPIRES_IN=8h
