# Server Environment Configuration
# Copy file ini, rename menjadi .env, lalu sesuaikan nilainya

# ── Database: Supabase (cloud) - dipakai jika terisi, prioritas paling atas ──
SUPABASE_DB_URL=

# ── Database PostgreSQL lokal (fallback, hanya dipakai jika SUPABASE_DB_URL kosong) ──
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dpbj_ui
DB_USER=postgres
DB_PASS=

# ── Server ──
PORT=3001
NODE_ENV=development

# ── CORS: URL frontend React ──
FRONTEND_URL=http://localhost:5173

# ── JWT Secret ──
# WAJIB diganti dengan nilai acak sendiri sebelum dipakai di luar development lokal.
# Cara generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_nilai_acak_sendiri
JWT_EXPIRES_IN=8h

# ── Email SMTP (untuk notifikasi: dokumen kedaluwarsa, undangan klarifikasi, dst) ──
# Kosongkan SMTP_HOST kalau belum ada akses SMTP - sistem otomatis fallback ke mode
# "catat log saja" tanpa mengirim email sungguhan (tidak akan membuat aplikasi error).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DPBJ UI E-Procurement <no-reply@ui.ac.id>
