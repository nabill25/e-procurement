# Server Environment Configuration
# Copy file ini, rename menjadi .env, lalu sesuaikan nilainya

# ── Database: Supabase (cloud) - dipakai jika terisi, prioritas paling atas ──
SUPABASE_DB_URL=

# ── Database PostgreSQL lokal (fallback, hanya dipakai jika SUPABASE_DB_URL kosong) ──
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dpbj_ui
DB_USER=postgres
DB_PASS=

# ── Supabase Storage (penyimpanan file upload - dokumen vendor, dokumen tender, gambar
# banner, dst). BEDA dari SUPABASE_DB_URL di atas (itu password database, ini kunci API
# terpisah untuk fitur Storage). Tanpa ini, fitur upload file tidak akan berfungsi.
# SUPABASE_URL      : URL project Supabase, contoh https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY : Supabase Dashboard > Settings > API > bagian "service_role"
#                              (BUKAN kunci "anon"/"public"). Setara password, jangan dikomit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ── Server ──
PORT=3001
NODE_ENV=development

# ── CORS: URL frontend React ──
FRONTEND_URL=http://localhost:5173

# ── JWT Secret ──
# WAJIB diganti dengan nilai acak sendiri sebelum dipakai di luar development lokal.
# Cara generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_nilai_acak_sendiri
JWT_EXPIRES_IN=8h

# ── Email SMTP (untuk notifikasi: dokumen kedaluwarsa, undangan klarifikasi, dst) ──
# Kosongkan SMTP_HOST kalau belum ada akses SMTP - sistem otomatis fallback ke mode
# "catat log saja" tanpa mengirim email sungguhan (tidak akan membuat aplikasi error).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DPBJ UI E-Procurement <no-reply@ui.ac.id>

# ── Integrasi Oracle ERP (RKA & Purchase Requisition masuk, Supplier & PO keluar) ──
# Kosongkan ORACLE_SFTP_HOST kalau kredensial belum didapat dari tim Oracle/keuangan kampus -
# sistem otomatis fallback (halaman monitoring tetap jalan, tombol impor manual/ekspor Excel
# tetap berfungsi, cuma tombol "Ambil dari Server SFTP" yang menampilkan pesan belum tersedia).
# JANGAN PERNAH isi nilai asli di file ini (.env.example ikut ter-commit ke git).
ORACLE_SFTP_HOST=
ORACLE_SFTP_PORT=22
ORACLE_SFTP_USER=
ORACLE_SFTP_PASS=
ORACLE_SFTP_PATH_RKA=titip/rka
ORACLE_SFTP_PATH_PR=titip/pr
